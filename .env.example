# Use a separate file, e.g. docker compose --env-file .env.docker up --build -d.
# Never commit credentials or use these empty values in production.
VRSCORE_DEMO_TOKEN=
OPENROUTER_API_KEY=
# Required if Hugging Face requests authentication for the configured model.
HF_TOKEN=
VRSCORE_DEMO_PORT=18765
VRSCORE_EMBEDDING_PORT=18766
# An optional JSON corpus path inside the demo container; null disables it.
VRSCORE_EXTRA_VACANCIES_PATH=null
